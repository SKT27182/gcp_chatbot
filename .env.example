# Repo-root .env — local FastAPI + deploy scripts (never commit).
# Cloud Run app knobs are injected from this file on `make deploy-backend`
# (Terraform additional_env_vars). Copy: cp .env.example .env

# ── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=asia-south1
FIRESTORE_DATABASE="(default)"

# ── LLM ─────────────────────────────────────────────────────────────────────
LITELLM_MODEL=vertex_ai/gemini-3.5-flash-lite
# Vertex: no API key — uses ADC / Cloud Run SA. Location often "global".
GCP_LOCATION=global
# API-key providers (AI Studio, OpenAI, …) instead of Vertex:
# LITELLM_MODEL=gemini/gemini-3.5-flash-lite
# LITELLM_API_KEY=
# LITELLM_BASE_URL=   # optional custom endpoint

# ── API ─────────────────────────────────────────────────────────────────────
# CORS: localhost + https://{GCP_PROJECT_ID}.web.app are automatic.
# Optional extras (custom domain): CORS_ALLOWED_ORIGINS=https://chat.example.com
CHAT_HISTORY_LIMIT=20
LOG_LEVEL=INFO
ENVIRONMENT=local
COST_LABEL_APP=chatbot

# Local Firestore: gcloud auth application-default login
# Optional: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json
