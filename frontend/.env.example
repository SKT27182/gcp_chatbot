# Local Vite + production Hosting builds (Vite loads this file only).
# After backend deploy: make show-outputs → set Cloud Run URL here → make deploy-frontend
VITE_API_BASE_URL=http://localhost:8000

# Firebase Auth (Console → Project settings → Your apps → Web app config)
# Enable Email/Password, Google, and GitHub under Authentication → Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
